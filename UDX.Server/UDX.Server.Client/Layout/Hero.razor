<section class="hero py-5">
    <div class="container">
        <div class="row align-items-center">

            <!-- Texto -->
            <div class="col-lg-6">

                <h1 class="display-4 fw-bold">
                    Aprender y enseñar nunca fue tan fácil.
                </h1>

                <p class="lead mt-3">
                    Conectamos alumnos que necesitan apoyo escolar
                    con profesores que quieren compartir sus conocimientos.
                </p>

                <!-- Buscador -->
                <div class="mt-4">

                    <label class="form-label fw-semibold">
                        ¿Qué materia necesitás?
                    </label>

                    <div class="input-group">

                        <select class="form-select">
                            <option value="">Seleccioná una materia</option>
                            <option value="matematica">Matemática</option>
                            <option value="lengua">Lengua</option>
                            <option value="ciencias-sociales">Ciencias Sociales</option>
                            <option value="ciencias-naturales">Ciencias Naturales</option>
                            <option value="ingles">Inglés</option>
                        </select>

                        <button class="btn btn-primary">
                            Buscar
                        </button>

                    </div>

                </div>

                <!-- Profesores -->
                <div class="mt-3">
                    <a href="/quiero-ensenar" class="btn btn-outline-primary">
                        <i class="bi bi-mortarboard-fill me-2"></i>
                        Quiero enseñar
                    </a>
                </div>

            </div>

            <!-- Imagen -->
            <div class="col-lg-6 mt-4 mt-lg-0">

                <img src="/IMG/hero-main.png"
                     alt="Profesor dando clases a un alumno"
                     class="img-fluid rounded-4">

            </div>

        </div>
    </div>
</section>