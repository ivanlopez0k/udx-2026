@using UDX.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="modal fade" id="loginModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <EditForm Model="this" OnValidSubmit="IniciarSesion">

                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <div class="alert alert-danger">
                            @mensaje
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label">
                            Email
                        </label>

                        <input type="email"
                               class="form-control"
                               placeholder="Ingrese su email"
                               @bind="email" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Contraseña
                        </label>

                        <input type="password"
                               class="form-control"
                               placeholder="Ingrese su contraseña"
                               @bind="password" />
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-primary">
                        Iniciar Sesion
                    </button>

                </div>

            </EditForm>

        </div>
    </div>
</div>

@code
{
    private string email = "";
    private string password = "";
    private string mensaje = "";

    private async Task IniciarSesion()
    {
        mensaje = "";

        if (string.IsNullOrWhiteSpace(email))
        {
            mensaje = "El email es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            mensaje = "La contraseña es obligatoria.";
            return;
        }

        var datos = new
        {
            Email = email,
            Password = password
        };

        var respuesta = await Http.PostAsJsonAsync(
            "api/Auth/login",
            datos);

        if (respuesta.IsSuccessStatusCode)
        {
            var resultado = await respuesta.Content
                .ReadFromJsonAsync<LoginResponseDTO>();

           if (resultado != null)
{
    await JS.InvokeVoidAsync(
        "localStorage.setItem",
        "token",
        resultado.Token);

    await JS.InvokeVoidAsync(
        "localStorage.setItem",
        "name",
        resultado.Name);

    await JS.InvokeVoidAsync(
        "localStorage.setItem",
        "role",
        resultado.Role.ToString());

    LimpiarFormulario();

    await JS.InvokeVoidAsync(
        "cerrarLoginModal");

    Navigation.NavigateTo(
        Navigation.Uri,
        forceLoad: true);
}
        }
        else
        {
            mensaje = await respuesta.Content.ReadAsStringAsync();
        }
    }

    private void LimpiarFormulario()
    {
        email = "";
        password = "";
        mensaje = "";
    }
}