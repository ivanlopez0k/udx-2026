@inject HttpClient Http
@inject IJSRuntime JS
<div class="modal fade" id="registerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Crear cuenta</h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label">Nombre</label>

                    <input type="text"
                           class="form-control"
                           placeholder="Ingrese su nombre"
                           @bind="nombre" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Soy</label>

                    <select class="form-select" @bind="rol">
                        <option value="0">Padre</option>
                        <option value="1">Profesor</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email</label>

                    <input type="email"
                           class="form-control"
                           placeholder="Ingrese su email"
                           @bind="email" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Teléfono</label>

                    <input type="text"
                           class="form-control"
                           placeholder="Ingrese su teléfono"
                           @bind="telefono" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>

                    <input type="password"
                           class="form-control"
                           placeholder="Ingrese una contraseña"
                           @bind="password" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Repetir contraseña</label>

                    <input type="password"
                           class="form-control"
                           placeholder="Repita la contraseña"
                           @bind="repetirPassword" />
                </div>

                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <div class="alert alert-danger">
                        @mensaje
                    </div>
                }

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-success"
                        @onclick="Registrarse">
                    Registrarse
                </button>

            </div>

        </div>
    </div>
</div>
@code
{
    private string nombre = "";
    private string email = "";
    private string password = "";
    private string repetirPassword = "";
    private string telefono = "";
    private int rol = 0;
    private string mensaje = "";

    private bool ValidarPassword()
    {
        if (password.Length < 8)
        {
            mensaje = "❌ La contraseña debe tener al menos 8 caracteres.";
            return false;
        }

        if (password != repetirPassword)
        {
            mensaje = "❌ Las contraseñas no coinciden.";
            return false;
        }

        mensaje = "";
        return true;
    }

    private async Task Registrarse()
    {
        if (!ValidarPassword())
            return;

        var datos = new
        {
            Name = nombre,
            Email = email,
            Phone = telefono,
            Password = password,
            Role = rol
        };

        var respuesta = await Http.PostAsJsonAsync(
        "api/Auth/register",
        datos);

        if (respuesta.IsSuccessStatusCode)
        {
            mensaje = "✅ Usuario registrado correctamente.";
            
        }
        else
        {
            var error = await respuesta.Content.ReadAsStringAsync();

            mensaje = $"❌ {error}";
        }


    }


}
