@using System.Net.Http.Json
@inject HttpClient Http

<div class="modal fade" id="registerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Crear cuenta
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <div class="mb-3">
                    <label class="form-label">
                        Nombre
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="Ingrese su nombre"
                           @bind="nombre" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Soy
                    </label>

                    <select class="form-select"
                            @bind="rol">

                        <option value="0">
                            Padre
                        </option>

                        <option value="1">
                            Profesor
                        </option>

                    </select>
                </div>
                @if (rol == 1)
                {
                    <div class="mb-3">
                        <label class="form-label">
                            Código de academia (opcional)
                        </label>

                        <input type="text"
                               class="form-control"
                               placeholder="Ej.: SEED0001"
                               @bind="academyCode" />
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label">
                        Email
                    </label>

                    <input type="email"
                           class="form-control"
                           placeholder="Ingrese su correo"
                           @bind="email" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Teléfono
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="Ingrese su teléfono"
                           @bind="telefono" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Contraseña
                    </label>

                    <input type="password"
                           class="form-control"
                           placeholder="Ingrese una contraseña"
                           @bind="password"
                           @bind:event="oninput" />

                    @if (!string.IsNullOrEmpty(password) &&
                         password.Length < 8)
                    {
                        <div class="text-danger mt-1">
                            ⚠ La contraseña debe tener al menos 8 caracteres.
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Repetir contraseña
                    </label>

                    <input type="password"
                           class="form-control"
                           placeholder="Repita la contraseña"
                           minlength="8"
                           @bind="repetirPassword" />
                </div>

                @if (!string.IsNullOrEmpty(mensaje))
                {
                    <div class="alert @(registroExitoso
                        ? "alert-success"
                        : "alert-danger")">

                        @mensaje

                    </div>
                }

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-success"
                        @onclick="Registrar">

                    Registrarse

                </button>

            </div>

        </div>
    </div>
</div>

@code
{
    private string nombre = "";
    private string email = "";
    private string telefono = "";
    private string password = "";
    private string repetirPassword = "";

    private int rol = 0;

    private string mensaje = "";
    private bool registroExitoso = false;

    private string academyCode = "";

    private async Task Registrar()
    {
        mensaje = "";
        registroExitoso = false;

        if (string.IsNullOrWhiteSpace(nombre))
        {
            mensaje = "El nombre es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(email))
        {
            mensaje = "El email es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(telefono))
        {
            mensaje = "El teléfono es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            mensaje = "La contraseña es obligatoria.";
            return;
        }

        if (string.IsNullOrWhiteSpace(repetirPassword))
        {
            mensaje = "Debés repetir la contraseña.";
            return;
        }

        if (password.Length < 8)
        {
            mensaje = "La contraseña debe tener al menos 8 caracteres.";
            return;
        }

        if (password != repetirPassword)
        {
            mensaje = "Las contraseñas no coinciden.";
            return;
        }

        var registro = new
        {
            Email = email,
            Password = password,
            Name = nombre,
            Phone = telefono,
            Role = rol,
            AcademyCode = rol == 1 && !string.IsNullOrWhiteSpace(academyCode)
            ? academyCode.Trim()
            : null
        };

        try
        {
            var response = await Http.PostAsJsonAsync(
                "api/Auth/register",
                registro);

            if (response.IsSuccessStatusCode)
            {
                registroExitoso = true;
                mensaje = "✅ Cuenta creada correctamente.";

                LimpiarFormulario();

                return;
            }

            if (response.StatusCode ==
                System.Net.HttpStatusCode.Conflict)
            {
                mensaje = "❌ Ese email ya está registrado.";
                return;
            }

            if (response.StatusCode ==
                System.Net.HttpStatusCode.BadRequest)
            {
                var error =
                    await response.Content.ReadAsStringAsync();

                mensaje = string.IsNullOrWhiteSpace(error)
                    ? "❌ Los datos ingresados no son válidos."
                    : $"❌ {error}";

                return;
            }

            mensaje =
                $"❌ No se pudo crear la cuenta. Código: {(int)response.StatusCode}";
        }
        catch
        {
            mensaje =
                "❌ No se pudo conectar con el servidor.";
        }
    }

    private void LimpiarFormulario()
    {
        nombre = "";
        email = "";
        telefono = "";
        password = "";
        repetirPassword = "";
        academyCode = "";
        rol = 0;
    }
}