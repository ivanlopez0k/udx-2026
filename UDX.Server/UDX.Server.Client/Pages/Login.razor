@page "/login"
@layout EmptyLayout
@using UDX.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Iniciar Sesión | UDX</PageTitle>

<div class="auth-split-layout">
    <!-- Left Showcase Column -->
    <div class="auth-showcase">
        <div class="auth-showcase-header">
            <a href="/" class="brand-group" style="text-decoration: none;">
                <img src="/assets/images/UDX.jpg" alt="UDX Primaria" class="brand-logo-img" />
                <div class="brand-info">
                    <span class="brand-title" style="color: #fff;">UDX</span>
                    <span class="brand-subtitle" style="color: #93c5fd;">PRIMARIA</span>
                </div>
            </a>
        </div>

        <div class="auth-showcase-body">
            <div class="auth-showcase-pill">
                <span>🎒</span> Apoyo Escolar de 1° a 7° Grado
            </div>
            <h2 class="auth-showcase-title">
                Acompañá el aprendizaje de tus hijos en un solo lugar.
            </h2>
            <p class="auth-showcase-desc">
                Conectamos familias con maestras particulares y academias pedagógicas de primaria para superar dudas en matemática, lectoescritura e inglés.
            </p>

            <!-- Social Proof Card -->
            <div class="auth-showcase-card">
                <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=120&h=120&fit=crop&crop=faces" alt="Prof. Laura Giménez" class="showcase-avatar" />
                <div class="showcase-text">
                    <strong>Prof. Laura Giménez</strong>
                    <p>Profesora en Educación Primaria</p>
                    <span class="showcase-rating">★ 4.9 • 53 familias la puntuaron</span>
                </div>
            </div>
        </div>

        <div class="auth-showcase-footer">
            <span>&copy; @DateTime.Now.Year UDX. Plataforma Educativa Segura.</span>
        </div>
    </div>

    <!-- Right Form Column -->
    <div class="auth-form-column">
        <div class="auth-form-wrapper">
            <div class="auth-top-nav">
                <a href="/" class="back-to-home">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    <span>Volver al inicio</span>
                </a>
                <span style="font-size: 0.85rem; color: var(--slate-400);">UDX Auth</span>
            </div>

            <h1 class="auth-heading">Bienvenido de vuelta</h1>
            <p class="auth-subheading">Ingresá tus credenciales para acceder a tu panel.</p>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger" style="border-radius: var(--radius-md); margin-bottom: 1.25rem;">
                    @mensajeError
                </div>
            }

            <form @onsubmit="IniciarSesion" @onsubmit:preventDefault>
                <div class="form-group">
                    <label class="form-label" for="loginEmail">Correo Electrónico</label>
                    <input 
                        type="email" 
                        id="loginEmail" 
                        class="form-control" 
                        placeholder="tu@email.com" 
                        @bind="email"
                        autocomplete="email" 
                        required 
                    />
                </div>

                <div class="form-group">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <label class="form-label" for="loginPassword">Contraseña</label>
                    </div>
                    <div class="password-input-wrap">
                        <input 
                            type="@(mostrarPassword ? "text" : "password")" 
                            id="loginPassword" 
                            class="form-control" 
                            placeholder="••••••••" 
                            @bind="password"
                            autocomplete="current-password" 
                            required 
                        />
                        <button type="button" class="btn-toggle-eye" @onclick="() => mostrarPassword = !mostrarPassword" title="Mostrar/Ocultar contraseña">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                            </svg>
                        </button>
                    </div>
                </div>

                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; margin-top: 0.5rem;">
                    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.85rem; color: var(--slate-600); cursor: pointer;">
                        <input type="checkbox" @bind="recordar" style="accent-color: var(--primary); width: 16px; height: 16px;" />
                        <span>Recordar mi sesión</span>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-full btn-lg" disabled="@cargando">
                    @if (cargando)
                    {
                        <span>Ingresando...</span>
                    }
                    else
                    {
                        <span>Iniciar Sesión</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M5 12h14M12 5l7 7-7 7"/>
                        </svg>
                    }
                </button>

                <p class="auth-switch-prompt">
                    ¿Todavía no tenés cuenta? <a href="/registro">Crear cuenta gratis</a>
                </p>
            </form>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private bool recordar = true;
    private bool mostrarPassword = false;
    private bool cargando = false;
    private string mensajeError = "";

    private async Task IniciarSesion()
    {
        mensajeError = "";

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            mensajeError = "Por favor completá todos los campos.";
            return;
        }

        cargando = true;

        try
        {
            var datos = new { Email = email, Password = password };
            var respuesta = await Http.PostAsJsonAsync("api/Auth/login", datos);

            if (respuesta.IsSuccessStatusCode)
            {
                var resultado = await respuesta.Content.ReadFromJsonAsync<LoginResponseDTO>();
                if (resultado != null && !string.IsNullOrWhiteSpace(resultado.Token))
                {
                    await JS.InvokeVoidAsync("localStorage.setItem", "token", resultado.Token);
                    await JS.InvokeVoidAsync("localStorage.setItem", "name", resultado.Name);
                    await JS.InvokeVoidAsync("localStorage.setItem", "role", resultado.Role.ToString());
                    await JS.InvokeVoidAsync("localStorage.setItem", "udx_token", resultado.Token);
                    await JS.InvokeVoidAsync("localStorage.setItem", "udx_name", resultado.Name);
                    await JS.InvokeVoidAsync("localStorage.setItem", "udx_role", resultado.Role.ToString());
                    await JS.InvokeVoidAsync("localStorage.setItem", "udx_email", resultado.Email);

                    // Redirigir según el rol
                    if (resultado.Role == 1 || resultado.Role == 2) // TEACHER o ACADEMY
                    {
                        Navigation.NavigateTo("/perfil-doc", forceLoad: true);
                    }
                    else
                    {
                        Navigation.NavigateTo("/perfil-padre", forceLoad: true);
                    }
                    return;
                }
            }

            var errContent = await respuesta.Content.ReadAsStringAsync();
            mensajeError = !string.IsNullOrWhiteSpace(errContent) ? errContent : "Credenciales inválidas. Por favor verificá tus datos.";
        }
        catch (Exception ex)
        {
            mensajeError = "No se pudo conectar con el servidor: " + ex.Message;
        }
        finally
        {
            cargando = false;
        }
    }
}
