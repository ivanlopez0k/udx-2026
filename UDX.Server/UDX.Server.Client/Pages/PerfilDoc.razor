@page "/perfil-doc"
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json
@layout MainLayout

@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Mi Panel Docente | UDX</PageTitle>

@if (cargando)
{
    <div class="text-center" style="padding: 10rem 0;">
        <h4 style="color: var(--slate-600);">Cargando panel docente...</h4>
    </div>
}
else
{
    <main class="container">
        <div class="panel-grid">
            <!-- Profile Column -->
            <aside class="profile-box">
                <div class="avatar-wrapper">
                    <img src="@(string.IsNullOrWhiteSpace(fotoUrl) ? "/assets/images/default-avatar.avif" : fotoUrl)"
                         alt="Foto de perfil" 
                         class="avatar-img" />
                    <label class="avatar-edit-label" title="Subir nueva foto">
                        ✎
                        <InputFile OnChange="SeleccionarFoto" style="display: none;" accept="image/*" />
                    </label>
                </div>

                <h2 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.25rem;">@(string.IsNullOrWhiteSpace(nombre) ? "Docente" : nombre)</h2>
                <p style="font-size: 0.825rem; color: var(--slate-500); margin-bottom: 1.25rem;">@email</p>

                <div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
                    <span class="badge badge-primary">📍 @(string.IsNullOrWhiteSpace(ubicacion) ? "Ubicación" : ubicacion)</span>
                    <span class="badge badge-rating">★ @calificacion.ToString("0.0") (@cantidadResenas)</span>
                    @if (verificado)
                    {
                        <span class="badge badge-verified">✓ Verificado</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(mensajeFoto))
                {
                    <div class="alert alert-danger" style="font-size: 0.8rem; padding: 0.5rem; margin-bottom: 1rem;">
                        @mensajeFoto
                    </div>
                }

                <a href="/profesores" class="btn btn-primary btn-full btn-sm">
                    Ver Directorio Público
                </a>
            </aside>

            <!-- Main Column -->
            <section>
                <!-- Profile Data Box -->
                <div class="content-box">
                    <div style="border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem; margin-bottom: 1.5rem;">
                        <span class="badge badge-primary" style="margin-bottom: 0.35rem;">Información Pedagógica</span>
                        <h2 style="font-size: 1.35rem; font-weight: 800; margin: 0;">Datos del Perfil Docente</h2>
                    </div>

                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <div class="alert @(guardadoCorrectamente ? "alert-success" : "alert-danger")" style="margin-bottom: 1.25rem;">
                            @mensaje
                        </div>
                    }

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="form-group">
                            <label class="form-label">Nombre Completo</label>
                            <input type="text" class="form-control" @bind="nombre" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Teléfono / WhatsApp</label>
                            <input type="text" class="form-control" @bind="telefono" placeholder="+54 9 11 ..." />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="form-group">
                            <label class="form-label">Correo Electrónico</label>
                            <input type="email" class="form-control" @bind="email" readonly style="background: var(--slate-100); cursor: not-allowed;" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Ubicación / Barrio</label>
                            <input type="text" class="form-control" @bind="ubicacion" placeholder="Ej: Belgrano, CABA" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="form-group">
                            <label class="form-label">Título / Credenciales</label>
                            <input type="text" class="form-control" @bind="credenciales" placeholder="Ej: Profesora en Educación Primaria" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Disponibilidad</label>
                            <input type="text" class="form-control" @bind="disponibilidad" placeholder="Ej: Lunes a Jueves por la tarde" />
                        </div>
                    </div>

                    <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                        <button class="btn btn-primary" @onclick="GuardarCambios">
                            Guardar Cambios
                        </button>
                        <button class="btn btn-outline" type="button" @onclick="CerrarSesion">
                            Cerrar Sesión
                        </button>
                    </div>
                </div>

                <!-- Subjects & Rates Box -->
                <div class="content-box">
                    <div style="border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem; margin-bottom: 1.25rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 800; margin: 0;">Mis Materias Primarias y Tarifas</h3>
                        <p style="font-size: 0.85rem; color: var(--slate-500); margin-top: 0.2rem;">Gestioná las materias que dictás y tus precios por hora.</p>
                    </div>

                    @if (cargandoMaterias)
                    {
                        <p style="color: var(--slate-500); font-size: 0.875rem;">Cargando materias...</p>
                    }
                    else
                    {
                        @if (materiasDocente.Count > 0)
                        {
                            <table class="panel-table">
                                <thead>
                                    <tr>
                                        <th>Materia</th>
                                        <th>Grado</th>
                                        <th>Precio / Hora</th>
                                        <th style="width: 50px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var materia in materiasDocente)
                                    {
                                        <tr>
                                            <td><strong>@materia.Nombre</strong></td>
                                            <td><span class="badge badge-outline">@materia.Grado</span></td>
                                            <td><strong style="color: var(--primary);">$@materia.PrecioPorHora.ToString("N0")</strong></td>
                                            <td>
                                                <button type="button"
                                                        class="btn btn-ghost btn-sm"
                                                        style="color: var(--accent-rose); font-size: 1.25rem; padding: 0 0.5rem;"
                                                        title="Eliminar materia"
                                                        @onclick="() => EliminarMateria(materia)">
                                                    &times;
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p style="color: var(--slate-500); font-size: 0.875rem;">Todavía no tenés materias asociadas.</p>
                        }

                        <!-- Add Subject Form -->
                        <div style="background: var(--slate-50); border: 1px solid var(--border-light); border-radius: var(--radius-xl); padding: 1.25rem; margin-top: 1.75rem;">
                            <h4 style="font-size: 0.95rem; font-weight: 800; margin-bottom: 0.75rem; color: var(--slate-900);">+ Agregar Nueva Materia</h4>
                            
                            <div style="display: grid; grid-template-columns: 2fr 1fr 1fr auto; gap: 0.75rem; align-items: flex-end;">
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="form-label" style="font-size: 0.75rem;">Materia</label>
                                    <select class="form-control" @bind="materiaIdSeleccionada">
                                        <option value="0">Seleccioná una materia</option>
                                        @foreach (var materia in catalogoMaterias)
                                        {
                                            <option value="@materia.Id">@materia.Name</option>
                                        }
                                    </select>
                                </div>

                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="form-label" style="font-size: 0.75rem;">Grado</label>
                                    <select class="form-control" @bind="nivelMateria">
                                        <option value="">Seleccioná</option>
                                        <option value="1">1° Grado</option>
                                        <option value="2">2° Grado</option>
                                        <option value="3">3° Grado</option>
                                        <option value="4">4° Grado</option>
                                        <option value="5">5° Grado</option>
                                        <option value="6">6° Grado</option>
                                        <option value="7">7° Grado</option>
                                        <option value="Todos">Todos los grados</option>
                                    </select>
                                </div>

                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="form-label" style="font-size: 0.75rem;">$ / Hora</label>
                                    <input class="form-control" type="number" min="500" step="100" @bind="precioMateria" placeholder="7500" />
                                </div>

                                <button type="button" class="btn btn-primary" @onclick="AgregarMateria">
                                    Agregar
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Danger Zone -->
                <div class="content-box" style="border-color: #fecaca; background: #fffdfd;">
                    <h3 style="font-size: 1.15rem; font-weight: 800; color: #991b1b; margin-bottom: 0.25rem;">Zona de Peligro</h3>
                    <p style="font-size: 0.85rem; color: var(--slate-500); margin-bottom: 1rem;">
                        Si eliminás tu cuenta docente, tu perfil desaparecerá del directorio público de profesores.
                    </p>
                    <button class="btn btn-outline" style="border-color: #ef4444; color: #dc2626;" type="button" @onclick="MostrarConfirmacionEliminar">
                        Eliminar mi Cuenta Docente
                    </button>
                </div>
            </section>
        </div>
    </main>
}

<!-- Modal Confirmación Eliminar Cuenta -->
@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay" @onclick="CancelarEliminar">
        <div class="modal-card" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title" style="color: #991b1b;">Confirmar Eliminación</h3>
                <button type="button" class="modal-close-btn" @onclick="CancelarEliminar">&times;</button>
            </div>
            <div class="modal-body">
                <p style="color: var(--slate-700);">
                    ¿Estás segura/o de que querés eliminar tu cuenta docente? Esta acción no se puede deshacer.
                </p>
            </div>
            <div class="modal-footer" style="justify-content: flex-end; gap: 0.75rem;">
                <button type="button" class="btn btn-outline" @onclick="CancelarEliminar">Cancelar</button>
                <button type="button" class="btn btn-primary" style="background: #dc2626;" @onclick="EliminarCuenta">
                    Sí, Eliminar Definitivamente
                </button>
            </div>
        </div>
    </div>
}

@code {
    private string nombre = "";
    private string email = "";
    private string telefono = "";
    private string credenciales = "";
    private decimal precioPorHora;
    private string ubicacion = "";
    private string disponibilidad = "";

    private bool mostrarConfirmacionEliminar = false;
    private float calificacion;
    private int cantidadResenas;
    private bool verificado;

    private string fotoUrl = "";
    private bool cargando = true;

    private string mensajeFoto = "";
    private string mensaje = "";
    private bool guardadoCorrectamente = false;

    private IBrowserFile? fotoSeleccionada;
    private PerfilRespuesta? perfil;

    private List<MateriaCatalogo> catalogoMaterias = new();
    private List<MateriaDocenteRespuesta> materiasDocente = new();

    private bool cargandoMaterias = true;
    private int materiaIdSeleccionada;
    private string nivelMateria = "";
    private decimal precioMateria;

    public class RespuestaFoto
    {
        public string mensaje { get; set; } = "";
        public string foto { get; set; } = "";
    }

    public class PerfilRespuesta
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string Email { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string Credenciales { get; set; } = "";
        public decimal PrecioPorHora { get; set; }
        public string Ubicacion { get; set; } = "";
        public float Calificacion { get; set; }
        public int CantidadResenas { get; set; }
        public string Disponibilidad { get; set; } = "";
        public bool Verificado { get; set; }
        public string Foto { get; set; } = "";
    }

    public class MateriaCatalogo
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Grade { get; set; } = "";
        public string Category { get; set; } = "";
    }

    public class MateriaDocenteRespuesta
    {
        public int MateriaId { get; set; }
        public string Nombre { get; set; } = "";
        public string Grado { get; set; } = "";
        public string Nivel { get; set; } = "";
        public decimal PrecioPorHora { get; set; }
    }

    private async Task SeleccionarFoto(InputFileChangeEventArgs e)
    {
        fotoSeleccionada = e.File;
        mensajeFoto = "";

        try
        {
            using var stream = fotoSeleccionada.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var bytes = memoryStream.ToArray();
            fotoUrl = $"data:{fotoSeleccionada.ContentType};base64,{Convert.ToBase64String(bytes)}";
        }
        catch (Exception)
        {
            fotoSeleccionada = null;
            mensajeFoto = "No se pudo cargar la imagen. Verificá que pese menos de 5 MB.";
        }
    }

    private async Task GuardarCambios()
    {
        mensaje = "";
        mensajeFoto = "";
        guardadoCorrectamente = false;

        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                    ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

        if (string.IsNullOrEmpty(token))
        {
            mensaje = "No hay una sesión iniciada.";
            return;
        }

        if (fotoSeleccionada != null)
        {
            try
            {
                using var stream = fotoSeleccionada.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var archivo = new StreamContent(stream);
                archivo.Headers.ContentType = new MediaTypeHeaderValue(fotoSeleccionada.ContentType);
                using var contenido = new MultipartFormDataContent();
                contenido.Add(archivo, "foto", fotoSeleccionada.Name);

                using var requestFoto = new HttpRequestMessage(HttpMethod.Post, "api/Docente/foto") { Content = contenido };
                requestFoto.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

                var respuestaFoto = await Http.SendAsync(requestFoto);
                if (respuestaFoto.IsSuccessStatusCode)
                {
                    var resultadoFoto = await respuestaFoto.Content.ReadFromJsonAsync<RespuestaFoto>();
                    if (resultadoFoto != null)
                    {
                        fotoUrl = resultadoFoto.foto;
                    }
                }
                fotoSeleccionada = null;
            }
            catch (Exception)
            {
                mensajeFoto = "Ocurrió un error al subir la foto.";
            }
        }

        var datos = new
        {
            Nombre = nombre,
            Telefono = telefono,
            Credenciales = credenciales,
            PrecioPorHora = precioPorHora,
            Ubicacion = ubicacion,
            Disponibilidad = disponibilidad
        };

        using var request = new HttpRequestMessage(HttpMethod.Put, "api/Docente/perfil")
        {
            Content = JsonContent.Create(datos)
        };
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var respuesta = await Http.SendAsync(request);

        if (!respuesta.IsSuccessStatusCode)
        {
            mensaje = "No se pudieron guardar los cambios.";
            guardadoCorrectamente = false;
            return;
        }

        mensaje = "Perfil docente actualizado correctamente.";
        guardadoCorrectamente = true;
    }

    private async Task CargarPerfil()
    {
        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                    ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/");
            return;
        }

        using var request = new HttpRequestMessage(HttpMethod.Get, "api/Docente/perfil");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var respuesta = await Http.SendAsync(request);

        if (respuesta.StatusCode == System.Net.HttpStatusCode.Unauthorized ||
            respuesta.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (!respuesta.IsSuccessStatusCode)
        {
            mensaje = "No se pudo cargar el perfil.";
            cargando = false;
            return;
        }

        perfil = await respuesta.Content.ReadFromJsonAsync<PerfilRespuesta>();

        if (perfil != null)
        {
            nombre = perfil.Nombre;
            email = perfil.Email;
            telefono = perfil.Telefono;
            credenciales = perfil.Credenciales;
            precioPorHora = perfil.PrecioPorHora;
            ubicacion = perfil.Ubicacion;
            disponibilidad = perfil.Disponibilidad;
            calificacion = perfil.Calificacion;
            cantidadResenas = perfil.CantidadResenas;
            verificado = perfil.Verificado;
        }

        cargando = false;
    }

    private async Task CargarFoto()
    {
        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                    ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

        if (string.IsNullOrEmpty(token)) return;

        using var request = new HttpRequestMessage(HttpMethod.Get, "api/Docente/foto");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var respuesta = await Http.SendAsync(request);
        if (respuesta.IsSuccessStatusCode)
        {
            var resultado = await respuesta.Content.ReadFromJsonAsync<RespuestaFoto>();
            if (resultado != null)
            {
                fotoUrl = resultado.foto;
            }
        }
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "token");
        await JS.InvokeVoidAsync("localStorage.removeItem", "role");
        await JS.InvokeVoidAsync("localStorage.removeItem", "name");
        await JS.InvokeVoidAsync("localStorage.removeItem", "udx_token");
        await JS.InvokeVoidAsync("localStorage.removeItem", "udx_name");
        await JS.InvokeVoidAsync("localStorage.removeItem", "udx_role");
        await JS.InvokeVoidAsync("localStorage.removeItem", "udx_email");
        Navigation.NavigateTo("/", forceLoad: true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await CargarPerfil();
        await CargarFoto();
        await CargarMaterias();
        StateHasChanged();
    }

    private void MostrarConfirmacionEliminar() => mostrarConfirmacionEliminar = true;
    private void CancelarEliminar() => mostrarConfirmacionEliminar = false;

    private async Task EliminarCuenta()
    {
        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                    ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        using var request = new HttpRequestMessage(HttpMethod.Delete, "api/Docente/cuenta");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var respuesta = await Http.SendAsync(request);
        if (!respuesta.IsSuccessStatusCode)
        {
            mensaje = "No se pudo eliminar la cuenta.";
            mostrarConfirmacionEliminar = false;
            return;
        }

        await CerrarSesion();
    }

    private async Task CargarMaterias()
    {
        cargandoMaterias = true;
        try
        {
            var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                        ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

            if (string.IsNullOrEmpty(token)) return;

            using var requestCatalogo = new HttpRequestMessage(HttpMethod.Get, "api/Materia");
            requestCatalogo.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var respuestaCatalogo = await Http.SendAsync(requestCatalogo);

            if (respuestaCatalogo.IsSuccessStatusCode)
            {
                var materias = await respuestaCatalogo.Content.ReadFromJsonAsync<List<MateriaCatalogo>>() ?? new List<MateriaCatalogo>();
                catalogoMaterias = materias
                    .GroupBy(m => m.Name.Trim(), StringComparer.OrdinalIgnoreCase)
                    .Select(g => g.OrderBy(m => m.Grade).ThenBy(m => m.Id).First())
                    .OrderBy(m => m.Name)
                    .ToList();
            }

            using var requestDocente = new HttpRequestMessage(HttpMethod.Get, "api/Docente/perfil/materias");
            requestDocente.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var respuestaDocente = await Http.SendAsync(requestDocente);

            if (respuestaDocente.IsSuccessStatusCode)
            {
                materiasDocente = await respuestaDocente.Content.ReadFromJsonAsync<List<MateriaDocenteRespuesta>>() ?? new List<MateriaDocenteRespuesta>();
            }
        }
        catch
        {
            // Fallback
        }
        finally
        {
            cargandoMaterias = false;
        }
    }

    private async Task AgregarMateria()
    {
        if (materiaIdSeleccionada <= 0)
        {
            mensaje = "Seleccioná una materia.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nivelMateria))
        {
            mensaje = "Indicá el grado.";
            return;
        }

        if (precioMateria <= 0)
        {
            mensaje = "Indicá un precio válido por hora.";
            return;
        }

        try
        {
            var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                        ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

            if (string.IsNullOrEmpty(token))
            {
                mensaje = "Tenés que iniciar sesión nuevamente.";
                return;
            }

            var datos = new
            {
                MateriaId = materiaIdSeleccionada,
                Nivel = nivelMateria,
                PrecioPorHora = precioMateria
            };

            using var request = new HttpRequestMessage(HttpMethod.Post, "api/Docente/perfil/materias");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            request.Content = JsonContent.Create(datos);

            var respuesta = await Http.SendAsync(request);

            if (respuesta.IsSuccessStatusCode)
            {
                guardadoCorrectamente = true;
                mensaje = "Materia agregada correctamente.";
                materiaIdSeleccionada = 0;
                nivelMateria = "";
                precioMateria = 0;
                await CargarMaterias();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                guardadoCorrectamente = false;
                mensaje = $"No se pudo agregar la materia: {detalle}";
            }
        }
        catch
        {
            mensaje = "Ocurrió un error al agregar la materia.";
        }
    }

    private async Task EliminarMateria(MateriaDocenteRespuesta materia)
    {
        try
        {
            var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                        ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

            if (string.IsNullOrEmpty(token))
            {
                mensaje = "Tenés que iniciar sesión nuevamente.";
                return;
            }

            var nivel = Uri.EscapeDataString(materia.Nivel);
            using var request = new HttpRequestMessage(HttpMethod.Delete, $"api/Docente/perfil/materias/{materia.MateriaId}?nivel={nivel}");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var respuesta = await Http.SendAsync(request);
            if (respuesta.IsSuccessStatusCode)
            {
                guardadoCorrectamente = true;
                mensaje = "Materia eliminada correctamente.";
                await CargarMaterias();
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                mensaje = $"No se pudo eliminar la materia: {detalle}";
            }
        }
        catch
        {
            mensaje = "Ocurrió un error al eliminar la materia.";
        }
    }
}
