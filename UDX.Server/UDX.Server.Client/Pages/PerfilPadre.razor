@page "/perfil-padre"
@using UDX.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@layout MainLayout
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Mi Panel Familiar | UDX</PageTitle>

@if (cargando)
{
    <div class="text-center" style="padding: 10rem 0;">
        <h4 style="color: var(--slate-600);">Cargando perfil familiar...</h4>
    </div>
}
else
{
    <main class="container">
        <div class="panel-grid">
            <!-- Profile Sidebar Column -->
            <aside class="profile-box">
                <div class="avatar-wrapper">
                    <img src="@(string.IsNullOrWhiteSpace(fotoPerfil) ? "/assets/images/default-avatar.avif" : fotoPerfil)"
                         alt="Foto de perfil" 
                         class="avatar-img" />
                    <label class="avatar-edit-label" title="Cambiar foto">
                        ✎
                        <InputFile OnChange="SeleccionarFoto" style="display: none;" accept="image/*" />
                    </label>
                </div>

                <h2 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.25rem;">@(string.IsNullOrWhiteSpace(nombre) ? "Familia" : nombre)</h2>
                <p style="font-size: 0.825rem; color: var(--slate-500); margin-bottom: 1.25rem;">@email</p>

                @if (!string.IsNullOrEmpty(mensajeFoto))
                {
                    <div class="alert alert-danger" style="font-size: 0.8rem; padding: 0.5rem; margin-bottom: 1rem;">
                        @mensajeFoto
                    </div>
                }

                <div style="background: var(--slate-50); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1rem; text-align: left; margin-bottom: 1.5rem;">
                    <strong style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--slate-500); display: block; margin-bottom: 0.5rem;">
                        Hijo/a a Cargo
                    </strong>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 1.25rem;">🎒</span>
                        <div>
                            <strong style="font-size: 0.95rem; color: var(--slate-900); display: block;">@(string.IsNullOrWhiteSpace(hijo) ? "Sin registrar" : hijo)</strong>
                            <span style="font-size: 0.8rem; color: var(--slate-500);">@(string.IsNullOrWhiteSpace(grado) ? "Grado escolar" : grado)</span>
                        </div>
                    </div>
                </div>

                <a href="/profesores" class="btn btn-primary btn-full btn-sm">
                    + Buscar Docente de Primaria
                </a>
            </aside>

            <!-- Main Content Column -->
            <section>
                <div class="content-box">
                    <div style="border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem; margin-bottom: 1.5rem;">
                        <span class="badge badge-primary" style="margin-bottom: 0.35rem;">Datos del Tutor</span>
                        <h2 style="font-size: 1.35rem; font-weight: 800; margin: 0;">Información de la Familia</h2>
                    </div>

                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <div class="alert @(guardadoCorrectamente ? "alert-success" : "alert-danger")" style="margin-bottom: 1.25rem;">
                            @mensaje
                        </div>
                    }

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="form-group">
                            <label class="form-label">Nombre del Tutor</label>
                            <input type="text" class="form-control" @bind="nombre" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Teléfono / WhatsApp</label>
                            <input type="text" class="form-control" @bind="telefono" placeholder="+54 9 11 ..." />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="form-group">
                            <label class="form-label">Correo Electrónico</label>
                            <input type="email" class="form-control" @bind="email" readonly style="background: var(--slate-100); cursor: not-allowed;" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Ciudad / Barrio</label>
                            <input type="text" class="form-control" @bind="ciudad" placeholder="Ej: Palermo, CABA" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.75rem;">
                        <div class="form-group">
                            <label class="form-label">Nombre de tu Hijo/a</label>
                            <input type="text" class="form-control" @bind="hijo" placeholder="Ej: Joaquín" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Grado Escolar</label>
                            <input type="text" class="form-control" @bind="grado" placeholder="Ej: 4° Grado Primaria" />
                        </div>
                    </div>

                    <div style="display: flex; gap: 0.75rem;">
                        <button class="btn btn-primary" @onclick="GuardarCambios">
                            Guardar Cambios
                        </button>
                        <button class="btn btn-outline" type="button" @onclick="CerrarSesion">
                            Cerrar Sesión
                        </button>
                    </div>
                </div>

                <!-- Danger Zone -->
                <div class="content-box" style="border-color: #fecaca; background: #fffdfd;">
                    <h3 style="font-size: 1.15rem; font-weight: 800; color: #991b1b; margin-bottom: 0.25rem;">Zona de Peligro</h3>
                    <p style="font-size: 0.85rem; color: var(--slate-500); margin-bottom: 1rem;">
                        Si eliminás tu cuenta familiar, se borrará todo el historial y clases asociadas permanentemente.
                    </p>
                    <button class="btn btn-outline" style="border-color: #ef4444; color: #dc2626;" type="button" @onclick="MostrarConfirmacionEliminar">
                        Eliminar mi Cuenta
                    </button>
                </div>
            </section>
        </div>
    </main>
}

<!-- Modal Confirmación Eliminar Cuenta -->
@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay" @onclick="CancelarEliminar">
        <div class="modal-card" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title" style="color: #991b1b;">Confirmar Eliminación</h3>
                <button type="button" class="modal-close-btn" @onclick="CancelarEliminar">&times;</button>
            </div>
            <div class="modal-body">
                <p style="color: var(--slate-700);">
                    ¿Estás segura/o de que querés eliminar tu cuenta? Esta acción no se puede deshacer.
                </p>
            </div>
            <div class="modal-footer" style="justify-content: flex-end; gap: 0.75rem;">
                <button type="button" class="btn btn-outline" @onclick="CancelarEliminar">Cancelar</button>
                <button type="button" class="btn btn-primary" style="background: #dc2626;" @onclick="EliminarCuenta">
                    Sí, Eliminar Definitivamente
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool cargando = true;
    private string nombre = "";
    private string email = "";
    private string telefono = "";
    private string ciudad = "";
    private string hijo = "";
    private string grado = "";
    private string fotoPerfil = "";
    private string mensaje = "";
    private string mensajeFoto = "";
    private bool guardadoCorrectamente = false;
    private bool mostrarConfirmacionEliminar = false;
    private IBrowserFile? fotoSeleccionada;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CargarPerfil();
        }
    }

    private async Task CargarPerfil()
    {
        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                    ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        using var request = new HttpRequestMessage(HttpMethod.Get, "api/Padre/perfil");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var respuesta = await Http.SendAsync(request);

        if (respuesta.IsSuccessStatusCode)
        {
            var perfil = await respuesta.Content.ReadFromJsonAsync<PerfilPadreDTO>();
            if (perfil != null)
            {
                nombre = perfil.Nombre ?? "";
                email = perfil.Email ?? "";
                telefono = perfil.Telefono ?? "";
                ciudad = perfil.Ciudad ?? "";
                hijo = perfil.Hijo ?? "";
                grado = perfil.Grado ?? "";
                fotoPerfil = perfil.FotoPerfil ?? "";
            }
        }
        else if (respuesta.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        cargando = false;
        StateHasChanged();
    }

    private async Task GuardarCambios()
    {
        mensajeFoto = "";
        mensaje = "";

        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                    ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

        if (fotoSeleccionada != null)
        {
            using var contenido = new MultipartFormDataContent();
            var stream = fotoSeleccionada.OpenReadStream(5 * 1024 * 1024);
            var archivo = new StreamContent(stream);
            contenido.Add(archivo, "foto", fotoSeleccionada.Name);

            using var reqFoto = new HttpRequestMessage(HttpMethod.Post, "api/Padre/foto") { Content = contenido };
            if (!string.IsNullOrEmpty(token)) reqFoto.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var respuestaFoto = await Http.SendAsync(reqFoto);
            if (!respuestaFoto.IsSuccessStatusCode)
            {
                mensajeFoto = "No se pudo actualizar la foto de perfil.";
            }
            fotoSeleccionada = null;
        }

        var datos = new PerfilPadreDTO
        {
            Nombre = nombre,
            Email = email,
            Telefono = telefono,
            Ciudad = ciudad,
            Hijo = hijo,
            Grado = grado
        };

        using var reqPerfil = new HttpRequestMessage(HttpMethod.Put, "api/Padre/perfil")
        {
            Content = JsonContent.Create(datos)
        };
        if (!string.IsNullOrEmpty(token)) reqPerfil.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var respuesta = await Http.SendAsync(reqPerfil);

        if (!respuesta.IsSuccessStatusCode)
        {
            mensaje = "No se pudieron guardar los cambios.";
            guardadoCorrectamente = false;
            return;
        }

        mensaje = "Perfil familiar actualizado correctamente.";
        guardadoCorrectamente = true;
    }

    private async Task SeleccionarFoto(InputFileChangeEventArgs e)
    {
        fotoSeleccionada = e.File;
        var buffer = new byte[fotoSeleccionada.Size];
        await fotoSeleccionada.OpenReadStream(5 * 1024 * 1024).ReadExactlyAsync(buffer);
        var base64 = Convert.ToBase64String(buffer);
        fotoPerfil = $"data:{fotoSeleccionada.ContentType};base64,{base64}";
        StateHasChanged();
    }

    private async Task CerrarSesion()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "token");
        await JS.InvokeVoidAsync("localStorage.removeItem", "name");
        await JS.InvokeVoidAsync("localStorage.removeItem", "role");
        await JS.InvokeVoidAsync("localStorage.removeItem", "udx_token");
        await JS.InvokeVoidAsync("localStorage.removeItem", "udx_name");
        await JS.InvokeVoidAsync("localStorage.removeItem", "udx_role");
        await JS.InvokeVoidAsync("localStorage.removeItem", "udx_email");
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private void MostrarConfirmacionEliminar() => mostrarConfirmacionEliminar = true;
    private void CancelarEliminar() => mostrarConfirmacionEliminar = false;

    private async Task EliminarCuenta()
    {
        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                    ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        using var request = new HttpRequestMessage(HttpMethod.Delete, "api/Padre/cuenta");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var respuesta = await Http.SendAsync(request);
        if (!respuesta.IsSuccessStatusCode)
        {
            mostrarConfirmacionEliminar = false;
            return;
        }

        await CerrarSesion();
    }
}
