@page "/quiero-ensenar"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Quiero Enseñar | UDX</PageTitle>

<main class="container" style="padding-top: 7rem; padding-bottom: 5rem;">
    <div style="max-width: 820px; margin: 0 auto; background: var(--white); border-radius: var(--radius-2xl); border: 1px solid var(--border-light); padding: 3rem 2.5rem; box-shadow: var(--shadow-xl);">
        <div style="text-align: center; margin-bottom: 2.5rem;">
            <span class="badge badge-primary" style="margin-bottom: 0.75rem;">Comunidad Docente de Primaria</span>
            <h1 style="font-size: 2.25rem; font-weight: 800; letter-spacing: -0.025em;">Sumate como Maestra/o de Primaria</h1>
            <p style="color: var(--slate-500); font-size: 0.95rem; margin-top: 0.5rem;">
                Publicá tus materias escolares de 1° a 7° grado, fijá tus tarifas por hora y conectá directamente con familias de tu zona.
            </p>
        </div>

        @if (!string.IsNullOrEmpty(mensajeExito))
        {
            <div class="alert alert-success" style="border-radius: var(--radius-lg); padding: 1.25rem; margin-bottom: 2rem; text-align: center;">
                <h4 style="font-weight: 800; margin-bottom: 0.5rem;">¡Bienvenida/o al equipo docente!</h4>
                <p style="margin: 0;">@mensajeExito</p>
                <div style="margin-top: 1rem;">
                    <a href="/login" class="btn btn-primary">Iniciar Sesión &rarr;</a>
                </div>
            </div>
        }
        else
        {
            <EditForm Model="@formulario" OnValidSubmit="@EnviarFormulario">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(errorMaterias))
                {
                    <div class="alert alert-danger" style="border-radius: var(--radius-md); margin-bottom: 1.5rem;">
                        @errorMaterias
                    </div>
                }

                <!-- Step 1: Personal Data -->
                <h3 style="font-size: 1.15rem; font-weight: 800; border-bottom: 1px solid var(--border-light); padding-bottom: 0.65rem; margin-bottom: 1.25rem;">
                    1. Datos Personales & Pedagógicos
                </h3>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                    <div class="form-group">
                        <label class="form-label">Nombre y Apellido</label>
                        <InputText class="form-control" @bind-Value="formulario.Nombre" placeholder="Ej: Prof. María Belén Fernández" />
                        <ValidationMessage For="@(() => formulario.Nombre)" class="text-danger" style="font-size: 0.8rem;" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Correo Electrónico</label>
                        <InputText class="form-control" type="email" @bind-Value="formulario.Email" placeholder="docente@ejemplo.com" />
                        <ValidationMessage For="@(() => formulario.Email)" class="text-danger" style="font-size: 0.8rem;" />
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 2rem;">
                    <div class="form-group">
                        <label class="form-label">Contraseña de Acceso</label>
                        <InputText class="form-control" type="password" @bind-Value="formulario.Password" placeholder="Mínimo 8 caracteres" />
                        <ValidationMessage For="@(() => formulario.Password)" class="text-danger" style="font-size: 0.8rem;" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Zona de Atención / Modalidad</label>
                        <InputText class="form-control" @bind-Value="formulario.Zona" placeholder="Ej: Belgrano, CABA / Clases Online" />
                        <ValidationMessage For="@(() => formulario.Zona)" class="text-danger" style="font-size: 0.8rem;" />
                    </div>
                </div>

                <!-- Step 2: Subjects & Rates -->
                <div style="margin-top: 2rem;">
                    <div style="border-bottom: 1px solid var(--border-light); padding-bottom: 0.65rem; margin-bottom: 1.25rem;">
                        <h3 style="font-size: 1.15rem; font-weight: 800; margin: 0;">
                            2. Materias Primarias a Dictar y Tarifas
                        </h3>
                        <p style="font-size: 0.85rem; color: var(--slate-500); margin-top: 0.25rem;">
                            Marcá las materias que podés enseñar y asigná tu tarifa horaria sugerida.
                        </p>
                    </div>

                    @if (cargandoMaterias)
                    {
                        <p style="color: var(--slate-500); font-size: 0.9rem;">Cargando catálogo de materias...</p>
                    }
                    else if (materiasDisponibles.Count == 0)
                    {
                        <p style="color: var(--slate-500); font-size: 0.9rem;">No hay materias cargadas en el sistema.</p>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: column; gap: 0.85rem;">
                            @foreach (var materia in materiasDisponibles)
                            {
                                <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.85rem 1.25rem; background: var(--slate-50); border: 1px solid var(--border-light); border-radius: var(--radius-lg); flex-wrap: wrap; gap: 0.75rem;">
                                    <div style="display: flex; align-items: center; gap: 0.75rem;">
                                        <input type="checkbox" id="mat_@materia.Id" checked="@materia.Seleccionada" @onchange="(e) => CambiarSeleccion(materia, e)" style="width: 18px; height: 18px; accent-color: var(--primary); cursor: pointer;" />
                                        <label for="mat_@materia.Id" style="cursor: pointer; font-weight: 700; color: var(--slate-900); font-size: 0.95rem; margin-bottom: 0;">
                                            @materia.Name
                                        </label>
                                        <span class="badge badge-outline" style="font-size: 0.72rem;">@materia.Grade</span>
                                    </div>

                                    @if (materia.Seleccionada)
                                    {
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <span style="font-size: 0.85rem; color: var(--slate-500); font-weight: 600;">$ / Hora:</span>
                                            <input type="number" class="form-control" style="width: 130px; font-weight: 700; color: var(--primary);" min="500" step="100" @bind="materia.Precio" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <button type="submit" class="btn btn-primary btn-lg btn-full" style="margin-top: 2.5rem;" disabled="@enviando">
                    @if (enviando)
                    {
                        <span>Registrando...</span>
                    }
                    else
                    {
                        <span>Completar Registro y Empezar a Enseñar &rarr;</span>
                    }
                </button>
            </EditForm>
        }
    </div>
</main>

@code {
    private FormularioDocente formulario = new();
    private string errorMaterias = "";
    private string mensajeExito = "";
    private bool cargandoMaterias = true;
    private bool enviando = false;
    private List<MateriaFormulario> materiasDisponibles = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            materiasDisponibles = await Http.GetFromJsonAsync<List<MateriaFormulario>>("api/Materia") ?? new List<MateriaFormulario>();
        }
        catch
        {
            // Fallback default subjects if API is empty
            materiasDisponibles = new List<MateriaFormulario>
            {
                new MateriaFormulario { Id = 1, Name = "Matemáticas Primaria", Grade = "1° a 7° Grado", Precio = 7500 },
                new MateriaFormulario { Id = 2, Name = "Prácticas del Lenguaje / Lectoescritura", Grade = "1° a 7° Grado", Precio = 7000 },
                new MateriaFormulario { Id = 3, Name = "Ciencias Naturales", Grade = "3° a 7° Grado", Precio = 6500 },
                new MateriaFormulario { Id = 4, Name = "Ciencias Sociales", Grade = "3° a 7° Grado", Precio = 6500 },
                new MateriaFormulario { Id = 5, Name = "Inglés Primaria Inicial", Grade = "1° a 7° Grado", Precio = 7500 },
                new MateriaFormulario { Id = 6, Name = "Apoyo Escolar Integral y Tareas", Grade = "Todos los Grados", Precio = 7000 }
            };
        }
        finally
        {
            cargandoMaterias = false;
        }
    }

    private void CambiarSeleccion(MateriaFormulario materia, ChangeEventArgs e)
    {
        materia.Seleccionada = e.Value is bool seleccionado && seleccionado;
        errorMaterias = "";
        mensajeExito = "";
    }

    private async Task EnviarFormulario()
    {
        errorMaterias = "";
        mensajeExito = "";

        var materiasSeleccionadas = materiasDisponibles
            .Where(m => m.Seleccionada)
            .ToList();

        if (materiasSeleccionadas.Count == 0)
        {
            errorMaterias = "Tenés que seleccionar al menos una materia que vayas a dictar.";
            return;
        }

        if (materiasSeleccionadas.Any(m => m.Precio <= 0))
        {
            errorMaterias = "Todos los precios deben ser mayores a $0.";
            return;
        }

        enviando = true;

        var dto = new
        {
            Name = formulario.Nombre.Trim(),
            Email = formulario.Email.Trim(),
            Password = formulario.Password,
            Zona = formulario.Zona.Trim(),
            Materias = materiasSeleccionadas.Select(m => new
            {
                MateriaId = m.Id,
                Nivel = string.IsNullOrWhiteSpace(m.Grade) ? "1° a 7° Grado" : m.Grade,
                PrecioPorHora = m.Precio
            }).ToList()
        };

        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/Auth/registro-docente", dto);

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeExito = "Tu cuenta docente se creó correctamente. Ya podés iniciar sesión para configurar tu perfil.";
                formulario = new FormularioDocente();
                foreach (var materia in materiasDisponibles)
                {
                    materia.Seleccionada = false;
                    materia.Precio = 7000;
                }
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();
                errorMaterias = string.IsNullOrWhiteSpace(detalle) ? "No se pudo registrar el docente." : detalle;
            }
        }
        catch (HttpRequestException)
        {
            errorMaterias = "Ocurrió un problema de conexión al registrar. Por favor, intentá nuevamente en unos minutos.";
        }
        finally
        {
            enviando = false;
        }
    }

    public class FormularioDocente
    {
        [Required(ErrorMessage = "Ingresá tu nombre completo.")]
        [StringLength(100, ErrorMessage = "El nombre no puede superar los 100 caracteres.")]
        public string Nombre { get; set; } = "";

        [Required(ErrorMessage = "Ingresá tu correo electrónico.")]
        [EmailAddress(ErrorMessage = "El correo electrónico no es válido.")]
        [StringLength(254, ErrorMessage = "El correo no puede superar los 254 caracteres.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Ingresá una contraseña.")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "La contraseña debe tener entre 8 y 100 caracteres.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Ingresá la zona donde das clases.")]
        [StringLength(100, ErrorMessage = "La zona no puede superar los 100 caracteres.")]
        public string Zona { get; set; } = "";
    }

    public class MateriaFormulario
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Grade { get; set; } = "";
        public string Category { get; set; } = "";
        public bool Seleccionada { get; set; }
        public decimal Precio { get; set; } = 7000;
        public string Nivel { get; set; } = "1° a 7° Grado";
    }
}
