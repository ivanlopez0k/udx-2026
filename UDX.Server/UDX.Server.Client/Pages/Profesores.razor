@page "/profesores"
@using UDX.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Profesores</PageTitle>

<div class="profesores-container">

    <h1>Profesores Disponibles</h1>

    @* FILTROS *@
    <div class="filter-sidebar-box" style="margin-bottom: 2rem; padding: 1.5rem;">
        <h3 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem;">
            Filtrar profesores
        </h3>

        <form @onsubmit="CargarProfesores" @onsubmit:preventDefault>

            <div class="form-group">
                <label class="form-label">Materia</label>
                <select class="form-control" @bind="filtroMateria">
                    <option value="">Todas las materias</option>
                    <option value="Matemáticas">Matemáticas</option>
                    <option value="Lenguaje">Lenguaje</option>
                    <option value="Naturales">Ciencias Naturales</option>
                    <option value="Sociales">Ciencias Sociales</option>
                    <option value="Inglés">Inglés</option>
                    <option value="Historia">Historia</option>
                    <option value="Educación Física">Educación Física</option>
                    <option value="Música">Música</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Ubicación</label>
                <input type="text"
                       class="form-control"
                       placeholder="Ej: Córdoba, Buenos Aires..."
                       @bind="filtroUbicacion" />
            </div>

            <div class="form-group">
                <label class="form-label">Precio máximo por hora</label>
                <input type="range"
                       min="3000"
                       max="25000"
                       step="500"
                       @bind="filtroMaxPrecio"
                       @bind:event="oninput"
                       style="width: 100%; accent-color: var(--primary);" />

                <div style="display: flex; justify-content: space-between;">
                    <span>$3.000</span>
                    <strong>$@filtroMaxPrecio.ToString("N0")</strong>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Calificación mínima</label>
                <select class="form-control" @bind="filtroMinRating">
                    <option value="0">Cualquier calificación</option>
                    <option value="4.5">4.5 o más</option>
                    <option value="4.8">4.8 o más</option>
                    <option value="4.9">4.9 o más</option>
                </select>
            </div>

            <div class="form-group"
                 style="display: flex; align-items: center; gap: 0.6rem;">
                <input type="checkbox"
                       id="soloVerificados"
                       @bind="filtroSoloVerificados" />

                <label for="soloVerificados">
                    Solo docentes verificados
                </label>
            </div>

            <div class="form-group">
                <label class="form-label">Ordenar por</label>
                <select class="form-control" @bind="filtroOrden">
                    <option value="rating_desc">Mejor puntuación</option>
                    <option value="precio_asc">Menor precio</option>
                    <option value="precio_desc">Mayor precio</option>
                </select>
            </div>

            <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <button type="submit"
                        class="btn btn-primary"
                        disabled="@cargando">
                    Filtrar profesores
                </button>

                <button type="button"
                        class="btn btn-outline"
                        @onclick="LimpiarFiltros"
                        disabled="@cargando">
                    Limpiar filtros
                </button>
            </div>

        </form>
    </div>

    @* TARJETAS ORIGINALES: SE CONSERVAN *@

    <div class="profesores-lista">

        @* Profesor 1: Luka Doncic *@
        <div class="profesor-card">
            <div class="profesor-foto">
                <img src="/IMG/luka.jpg" alt="Luka Doncic">
            </div>

            <div class="profesor-info">
                <h2>
                    Luka Doncic
                    <img src="/IMG/verificado.png"
                         alt="Verificado"
                         class="verificado">
                </h2>

                <p class="profesor-materia">Matemáticas</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Buenos Aires
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    5.0
                </p>
            </div>
        </div>

        @* Profesor 2: Pepe Reina *@
        <div class="profesor-card">
            <div class="profesor-foto">
                <img src="/IMG/pepe.jpg" alt="Pepe Reina">
            </div>

            <div class="profesor-info">
                <h2>Pepe Reina</h2>

                <p class="profesor-materia">Historia</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Córdoba
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    3.0
                </p>
            </div>
        </div>

        @* Profesor 3: Lionel Messi *@
        <div class="profesor-card">
            <div class="profesor-foto">
                <img src="/IMG/messi.jpg" alt="Lionel Messi">
            </div>

            <div class="profesor-info">
                <h2>
                    Lionel Messi
                    <img src="/IMG/verificado.png"
                         alt="Verificado"
                         class="verificado">
                </h2>

                <p class="profesor-materia">Educación Física</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Rosario, Santa Fe
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    4.9
                </p>
            </div>
        </div>

        @* Profesor 4: Gerónimo Benavidez *@
        <div class="profesor-card">
            <div class="profesor-foto">
                <img src="/IMG/momo.jpg" alt="Gerónimo Benavidez">
            </div>

            <div class="profesor-info">
                <h2>Gerónimo Benavidez</h2>

                <p class="profesor-materia">Historia</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Buenos Aires
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    4.1
                </p>
            </div>
        </div>

        @* Profesor 5: Mauro Lombardo *@
        <div class="profesor-card">
            <div class="profesor-foto">
                <img src="/IMG/duki.jpg" alt="Mauro Lombardo">
            </div>

            <div class="profesor-info">
                <h2>
                    Mauro Lombardo
                    <img src="/IMG/verificado.png"
                         alt="Verificado"
                         class="verificado">
                </h2>

                <p class="profesor-materia">Música</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Córdoba
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    4.4
                </p>
            </div>
        </div>

        @* Profesor 6: Ronald Araujo *@
        <div class="profesor-card">
            <div class="profesor-foto">
                <img src="/IMG/araujo.jpg" alt="Ronald Araujo">
            </div>

            <div class="profesor-info">
                <h2>
                    Ronald Araujo
                    <img src="/IMG/verificado.png"
                         alt="Verificado"
                         class="verificado">
                </h2>

                <p class="profesor-materia">Educación Física</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Tucumán
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    4.3
                </p>
            </div>
        </div>

    </div>

    @* PROFESORES REGISTRADOS DESDE LA API *@

    <h2 style="margin-top: 2.5rem;">Docentes registrados</h2>

    @if (cargando)
    {
        <p>Cargando profesores...</p>
    }
    else if (!string.IsNullOrEmpty(mensajeError))
    {
        <p>@mensajeError</p>
    }
    else if (profesores.Count == 0)
    {
        <p>No se encontraron profesores con esos filtros.</p>
    }
    else
    {
        <div class="profesores-lista">

            @foreach (var profesor in profesores)
            {
                <div class="profesor-card">

                    <div class="profesor-foto">
                        <img src="@(string.IsNullOrWhiteSpace(profesor.Foto)
                            ? "images/default-avatar.avif"
                            : profesor.Foto)"
                             alt="Foto de @profesor.Nombre">
                    </div>

                    <div class="profesor-info">
                        <h2>
                            @profesor.Nombre

                            @if (profesor.Verified)
                            {
                                <img src="/IMG/verificado.png"
                                     alt="Verificado"
                                     class="verificado">
                            }
                        </h2>

                        <p class="profesor-materia">
                            @(profesor.Materias?.FirstOrDefault() ?? "Sin materias")
                        </p>

                        <p class="profesor-dato">
                            <img src="/IMG/PIN.png" alt="">
                            @(string.IsNullOrWhiteSpace(profesor.Location)
                                ? "Ubicación no especificada"
                                : profesor.Location)
                        </p>

                        <p class="profesor-dato">
                            <img src="/IMG/estrella.png" alt="">
                            @profesor.RatingAvg.ToString("0.0")
                        </p>

                        @if (profesor.HourlyRate > 0)
                        {
                            <p class="profesor-dato">
                                Precio por hora:
                                $@profesor.HourlyRate.ToString("N0")
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(profesor.Availability))
                        {
                            <p class="profesor-dato">
                                Disponibilidad:
                                @profesor.Availability
                            </p>
                        }

                        <button class="btn btn-primary mt-2"
                                style="width: 120px;"
                                @onclick="() => IrAlPerfil(profesor.Id)">
                            Ver perfil
                        </button>
                    </div>
                </div>
            }

        </div>
    }

</div>

@code {
    [SupplyParameterFromQuery(Name = "materia")]
    public string? QueryMateria { get; set; }

    private List<ProfesorDto> profesores = new();

    private string filtroMateria = "";
    private string filtroUbicacion = "";
    private decimal filtroMaxPrecio = 25000;
    private double filtroMinRating = 0;
    private bool filtroSoloVerificados = false;
    private string filtroOrden = "rating_desc";

    private bool cargando = true;
    private string mensajeError = "";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(QueryMateria))
        {
            filtroMateria = QueryMateria;
        }

        await CargarProfesores();
    }

    private async Task CargarProfesores()
    {
        cargando = true;
        mensajeError = "";

        try
        {
            var query = new List<string>();

            if (!string.IsNullOrWhiteSpace(filtroMateria))
                query.Add($"materia={Uri.EscapeDataString(filtroMateria)}");

            if (!string.IsNullOrWhiteSpace(filtroUbicacion))
                query.Add($"ubicacion={Uri.EscapeDataString(filtroUbicacion)}");

            if (filtroMaxPrecio < 25000)
                query.Add($"maxPrecio={filtroMaxPrecio}");

            if (filtroMinRating > 0)
                query.Add($"minRating={filtroMinRating}");

            if (filtroSoloVerificados)
                query.Add("soloVerificados=true");

            if (!string.IsNullOrWhiteSpace(filtroOrden))
                query.Add($"orden={Uri.EscapeDataString(filtroOrden)}");

            var queryString = query.Count > 0
                ? "?" + string.Join("&", query)
                : "";

            var respuesta =
                await Http.GetFromJsonAsync<ProfesoresPaginadosDto>(
                    $"api/Docente/buscar{queryString}"
                );

            profesores = respuesta?.Items ?? new List<ProfesorDto>();
        }
        catch (Exception)
        {
            mensajeError = "No se pudieron cargar los profesores.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task LimpiarFiltros()
    {
        filtroMateria = "";
        filtroUbicacion = "";
        filtroMaxPrecio = 25000;
        filtroMinRating = 0;
        filtroSoloVerificados = false;
        filtroOrden = "rating_desc";

        await CargarProfesores();
    }

    private void IrAlPerfil(int docenteId)
    {
        Navigation.NavigateTo($"/profesores/{docenteId}");
    }
}
