@page "/profesores"

<PageTitle>Profesores</PageTitle>

@code {
    private bool mostrarModal = false;

    private string fotoSeleccionada = "";
    private string nombreSeleccionado = "";
    private string materiaSeleccionada = "";
    private string ubicacionSeleccionada = "";

    private void AbrirModal(string foto, string nombre, string materia, string ubicacion)
    {
        fotoSeleccionada = foto;
        nombreSeleccionado = nombre;
        materiaSeleccionada = materia;
        ubicacionSeleccionada = ubicacion;

        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }
}

<div class="profesores-container">
    
    <h1>Profesores Disponibles</h1>

    <div class="profesores-lista">

        <!-- PROFESOR 1 Lukita Doncic -->
        <div class="profesor-card"
             @onclick='() => AbrirModal("/IMG/luka.jpg", "Luka Doncic", "Matemáticas", "Buenos Aires")'>

            <div class="profesor-foto">
                <img src="/IMG/luka.jpg" alt="Luka Doncic">
            </div>

            <div class="profesor-info">

                <h2>
                    Luka Doncic
                    <img src="/IMG/verificado.png"
                         alt="Verificado"
                         class="verificado">
                </h2>

                <p class="profesor-materia">
                    Matemáticas
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Buenos Aires
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    5.0
                </p>

            </div>

        </div>




        <!-- Profesor 2 Pepe -->
