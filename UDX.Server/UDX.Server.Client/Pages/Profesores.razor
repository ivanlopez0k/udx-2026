             @onclick='() => AbrirModal("/IMG/luka.jpg", "Luka Doncic", "Matemáticas", "Buenos Aires")'>

            <div class="profesor-foto">
                <img src="/IMG/luka.jpg" alt="Luka Doncic">
            </div>

            <div class="profesor-info">
                <h2>
                    Luka Doncic
                    <img src="/IMG/verificado.png"
                         alt="Verificado"
                         class="verificado">
                </h2>

                <p class="profesor-materia">Matemáticas</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Buenos Aires
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    5.0
                </p>
            </div>
        </div>

        @* Profesor 2: Pepe Reina *@
        <div class="profesor-card"
             @onclick='() => AbrirModal("/IMG/pepe.jpg", "Pepe Reina", "Historia", "Córdoba")'>

            <div class="profesor-foto">
                <img src="/IMG/pepe.jpg" alt="Pepe Reina">
            </div>

            <div class="profesor-info">
                <h2>Pepe Reina</h2>

                <p class="profesor-materia">Historia</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Córdoba
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    3.0
                </p>
            </div>
        </div>

        @* Profesor 3: Lionel Messi *@
        <div class="profesor-card"
             @onclick='() => AbrirModal("/IMG/messi.jpg", "Lionel Messi", "Educación Física", "Rosario, Santa Fe")'>

            <div class="profesor-foto">
                <img src="/IMG/messi.jpg" alt="Lionel Messi">
            </div>

            <div class="profesor-info">
                <h2>
                    Lionel Messi
                    <img src="/IMG/verificado.png"
                         alt="Verificado"
                         class="verificado">
                </h2>

                <p class="profesor-materia">Educación Física</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Rosario, Santa Fe
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    4.9
                </p>
            </div>
        </div>

        @* Profesor 4: Gerónimo Benavidez *@
        <div class="profesor-card"
             @onclick='() => AbrirModal("/IMG/momo.jpg", "Gerónimo Benavidez", "Historia", "Buenos Aires")'>

            <div class="profesor-foto">
                <img src="/IMG/momo.jpg" alt="Gerónimo Benavidez">
            </div>

            <div class="profesor-info">
                <h2>Gerónimo Benavidez</h2>

                <p class="profesor-materia">Historia</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Buenos Aires
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    4.1
                </p>
            </div>
        </div>

        @* Profesor 5: Mauro Lombardo *@
        <div class="profesor-card"
             @onclick='() => AbrirModal("/IMG/duki.jpg", "Mauro Lombardo", "Música", "Córdoba")'>

            <div class="profesor-foto">
                <img src="/IMG/duki.jpg" alt="Mauro Lombardo">
            </div>

            <div class="profesor-info">
                <h2>
                    Mauro Lombardo
                    <img src="/IMG/verificado.png"
                         alt="Verificado"
                         class="verificado">
                </h2>

                <p class="profesor-materia">Música</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Córdoba
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    4.4
                </p>
            </div>
        </div>

        @* Profesor 6: Ronald Araujo *@
        <div class="profesor-card"
             @onclick='() => AbrirModal("/IMG/araujo.jpg", "Ronald Araujo", "Educación Física", "Tucumán")'>

            <div class="profesor-foto">
                <img src="/IMG/araujo.jpg" alt="Ronald Araujo">
            </div>

            <div class="profesor-info">
                <h2>
                    Ronald Araujo
                    <img src="/IMG/verificado.png"
                         alt="Verificado"
                         class="verificado">
                </h2>

                <p class="profesor-materia">Educación Física</p>

                <p class="profesor-dato">
                    <img src="/IMG/PIN.png" alt="">
                    Tucumán
                </p>

                <p class="profesor-dato">
                    <img src="/IMG/estrella.png" alt="">
                    4.3
                </p>
            </div>
        </div>

    </div>

    @* PROFESORES REGISTRADOS DESDE LA API *@


    @if (cargando)
    {
        <p>Cargando profesores...</p>
    }
    else if (!string.IsNullOrEmpty(mensajeError))
    {
        <p>@mensajeError</p>
    }
    else if (profesores.Count == 0)
    {
        <p>Todavía no hay profesores registrados.</p>
    }
    else
    {
        <div class="profesores-lista">

            @foreach (var profesor in profesores)
            {
                <div class="profesor-card"
                     @onclick='() => AbrirModal(
                         string.IsNullOrWhiteSpace(profesor.Foto)
                             ? "images/default-avatar.avif"
                             : profesor.Foto,
                         profesor.Nombre,
                         profesor.Materias.FirstOrDefault() ?? "Sin materias",
                         profesor.Location)'>

<div class="profesor-foto">
                        <img src="@(string.IsNullOrWhiteSpace(profesor.Foto)
                             ? "images/default-avatar.avif"
                             : profesor.Foto)"
                             alt="Foto de @profesor.Nombre">
                    </div>

                    <div class="profesor-info">
                        <h2>
                            @profesor.Nombre

                            @if (profesor.Verified)
                            {
                                <img src="/IMG/verificado.png"
                                     alt="Verificado"
                                     class="verificado">
                            }
                        </h2>

                        <p class="profesor-materia">
                            @(profesor.Materias.FirstOrDefault() ?? "Sin materias")
                        </p>

                        <p class="profesor-dato">
                            <img src="/IMG/PIN.png" alt="">
                            @(string.IsNullOrWhiteSpace(profesor.Location)
                                ? "Ubicación no especificada"
                                : profesor.Location)
                        </p>

                        <p class="profesor-dato">
                            <img src="/IMG/estrella.png" alt="">
                            @profesor.RatingAvg.ToString("0.0")
                        </p>

                        @if (profesor.HourlyRate > 0)
                        {
                            <p class="profesor-dato">
                                Precio por hora:
                                $@profesor.HourlyRate.ToString("N0")
                            </p>
                        }

                        @if (!string.IsNullOrWhiteSpace(profesor.Availability))
                        {
                            <p class="profesor-dato">
                                Disponibilidad:
                                @profesor.Availability
                            </p>
                        }
                    </div>
                </div>
            }

        </div>
    }

</div>

@* MODAL DE DETALLE DEL PROFESOR *@

<ProfesorModal Mostrar="@mostrarModal"
               Foto="@fotoSeleccionada"
               Nombre="@nombreSeleccionado"
               Materia="@materiaSeleccionada"
               Ubicacion="@ubicacionSeleccionada"
               CerrarModal="@CerrarModal" />

@code {
    private List<ProfesorDto> profesores = new();

    private bool cargando = true;
    private string mensajeError = "";

    private bool mostrarModal = false;

    private string fotoSeleccionada = "";
    private string nombreSeleccionado = "";
    private string materiaSeleccionada = "";
    private string ubicacionSeleccionada = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var respuesta =
                await Http.GetFromJsonAsync<ProfesoresPaginadosDto>(
                    "api/Docente/buscar"
                );

            profesores = respuesta?.Items ?? new List<ProfesorDto>();
        }
        catch (Exception)
        {
            mensajeError = "No se pudieron cargar los profesores.";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModal(
        string foto,
        string nombre,
        string materia,
        string ubicacion)
    {
        fotoSeleccionada = foto;
        nombreSeleccionado = nombre;
        materiaSeleccionada = materia;
        ubicacionSeleccionada = ubicacion;

        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
    }
}
