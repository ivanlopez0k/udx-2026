@page "/profesores"

@using UDX.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Profesores</PageTitle>

<div class="profesores-container">

    <h1>Profesores Disponibles</h1>

    @* TARJETAS ORIGINALES: SE CONSERVAN *@

    <div class="profesores-lista">

        @* Profesor 1: Luka Doncic *@
