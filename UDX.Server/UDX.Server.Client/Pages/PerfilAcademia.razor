@page "/perfil-academia"
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using UDX.Server.Client.Services
@layout MainLayout

@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ProfilePhotoStateService PhotoState

<PageTitle>Mi Panel Academia | UDX</PageTitle>

@if (cargando)
{
    <div class="text-center" style="padding: 10rem 0;">
        <h4 style="color: var(--slate-600);">Cargando panel de academia...</h4>
    </div>
}
else if (academia == null)
{
    <main class="container">
        <div class="content-box" style="margin-top: 7rem; text-align: center;">
            <span style="font-size: 3rem;">🏛️</span>
            <h2 style="font-size: 1.35rem; font-weight: 800; margin-top: 0.75rem;">Todavía no tenés una academia a tu cargo</h2>
            <p style="color: var(--slate-500); font-size: 0.9rem; margin-bottom: 1.5rem;">
                Creá una academia oficial desde tu panel docente o pedí que te asignen una como responsable.
            </p>
            <a href="/perfil-doc" class="btn btn-primary">Ir a mi panel docente</a>
        </div>
    </main>
}
else
{
    <main class="container">
        @if (modoDemo)
        {
            <div class="alert alert-info" style="margin-top: 7rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                <span>👀</span>
                <span>Vista de demostración — iniciá sesión como cuenta de academia para gestionar tu perfil real.</span>
            </div>
        }
        <div class="panel-grid" style="@(modoDemo ? "padding-top: 1.5rem;" : "")">

            <!-- Profile Column -->
            <aside class="profile-box">
                <div class="avatar-wrapper">
                    <img src="/assets/images/default-avatar.avif"
                         alt="Logo de la academia"
                         class="avatar-img" />
                    <span class="avatar-edit-label" title="Academia oficial" style="cursor: default;">🏛️</span>
                </div>

                <h2 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 0.25rem;">@(string.IsNullOrWhiteSpace(nombre) ? "Academia" : nombre)</h2>
                <p style="font-size: 0.825rem; color: var(--slate-500); margin-bottom: 1.25rem;">@email</p>

                <div style="display: flex; justify-content: center; gap: 0.5rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
                    @if (!string.IsNullOrWhiteSpace(ubicacion))
                    {
                        <span class="badge badge-primary">📍 @ubicacion</span>
                    }
                    @if (activa)
                    {
                        <span class="badge badge-verified">✓ Activa</span>
                    }
                    else
                    {
                        <span class="badge badge-outline">Inactiva</span>
                    }
                    <span class="badge badge-outline">🎟️ @codigo</span>
                </div>

                @if (!string.IsNullOrEmpty(mensajeFoto))
                {
                    <div class="alert alert-danger" style="font-size: 0.8rem; padding: 0.5rem; margin-bottom: 1rem;">
                        @mensajeFoto
                    </div>
                }

                <div style="background: var(--slate-50); border: 1px solid var(--border-light); border-radius: var(--radius-lg); padding: 1rem; text-align: left; margin-bottom: 1.5rem;">
                    <strong style="font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--slate-500); display: block; margin-bottom: 0.5rem;">
                        Código de invitación
                    </strong>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span style="font-size: 1.25rem;">🎟️</span>
                        <div>
                            <strong style="font-size: 0.95rem; color: var(--slate-900); display: block; letter-spacing: 0.08em;">
                                @codigo
                            </strong>
                            <span style="font-size: 0.8rem; color: var(--slate-500);">
                                Compartilo para que se unan docentes
                            </span>
                        </div>
                    </div>
                </div>

                <a href="/profesores" class="btn btn-primary btn-full btn-sm">
                    Ver Directorio Público
                </a>

                <button type="button" class="btn btn-outline btn-full btn-sm" style="margin-top: 0.5rem;" @onclick="CerrarSesion">
                    Cerrar Sesión
                </button>
            </aside>

            <!-- Main Column -->
            <section>
                <!-- Profile Data Box -->
                <div class="content-box">
                    <div style="border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem; margin-bottom: 1.5rem;">
                        <span class="badge badge-primary" style="margin-bottom: 0.35rem;">Información Institucional</span>
                        <h2 style="font-size: 1.35rem; font-weight: 800; margin: 0;">Datos de la Academia</h2>
                    </div>

                    @if (!string.IsNullOrEmpty(mensaje))
                    {
                        <div class="alert @(guardadoCorrectamente ? "alert-success" : "alert-danger")" style="margin-bottom: 1.25rem;">
                            @mensaje
                        </div>
                    }

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="form-group">
                            <label class="form-label">Nombre de la academia</label>
                            <input type="text" class="form-control" @bind="nombre" readonly style="background: var(--slate-100); cursor: not-allowed;" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Teléfono / WhatsApp</label>
                            <input type="text" class="form-control" @bind="telefono" placeholder="+54 9 11 ..." />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="form-group">
                            <label class="form-label">Correo Electrónico</label>
                            <input type="email" class="form-control" @bind="email" readonly style="background: var(--slate-100); cursor: not-allowed;" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Ubicación / Barrio</label>
                            <input type="text" class="form-control" @bind="ubicacion" placeholder="Ej: Nueva Córdoba, Córdoba" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Descripción</label>
                        <textarea class="form-control" rows="4" @bind="descripcion" placeholder="Contanos sobre tu academia, servicios y enfoque pedagógico..."></textarea>
                    </div>

                    <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                        <button class="btn btn-primary" @onclick="GuardarCambios" disabled="@guardando">
                            @(guardando ? "Guardando..." : "Guardar Cambios")
                        </button>
                    </div>
                </div>

                <!-- Prices Box -->
                <div class="content-box">
                    <div style="border-bottom: 1px solid var(--border-light); padding-bottom: 0.75rem; margin-bottom: 1.25rem;">
                        <h3 style="font-size: 1.25rem; font-weight: 800; margin: 0;">Tarifas de la Academia</h3>
                        <p style="font-size: 0.85rem; color: var(--slate-500); margin-top: 0.2rem;">Definí los precios generales que verán las familias.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajePrecios))
                    {
                        <div class="alert @(guardadoPreciosCorrecto ? "alert-success" : "alert-danger")" style="margin-bottom: 1.25rem;">
                            @mensajePrecios
                        </div>
                    }

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div class="form-group">
                            <label class="form-label">$ / Hora</label>
                            <input class="form-control" type="number" min="0" step="100" @bind="precioPorHora" placeholder="Ej: 8000" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">$ / Curso</label>
                            <input class="form-control" type="number" min="0" step="100" @bind="precioPorCurso" placeholder="Ej: 25000" />
                        </div>
                    </div>

                    <div style="display: flex; gap: 0.75rem; margin-top: 1.5rem;">
                        <button class="btn btn-primary" @onclick="GuardarPrecios" disabled="@guardandoPrecios">
                            @(guardandoPrecios ? "Guardando..." : "Guardar Tarifas")
                        </button>
                    </div>
                </div>

                <!-- Danger Zone -->
                <div class="content-box" style="border-color: #fecaca; background: #fffdfd;">
                    <h3 style="font-size: 1.15rem; font-weight: 800; color: #991b1b; margin-bottom: 0.25rem;">Zona de peligro</h3>
                    <p style="font-size: 0.85rem; color: var(--slate-500); margin-bottom: 1rem;">
                        Al eliminar tu cuenta, la academia y todos sus datos se borrarán permanentemente.
                    </p>
                    <button class="btn btn-outline" style="border-color: #ef4444; color: #dc2626;" type="button" @onclick="MostrarConfirmacionEliminar">
                        Eliminar mi Cuenta
                    </button>
                </div>
            </section>
        </div>
    </main>
}

<!-- MODAL DE CONFIRMACIÓN ELIMINAR CUENTA -->
@if (mostrarConfirmacionEliminar)
{
    <div class="modal-overlay active" @onclick="CancelarEliminar">
        <div class="modal-card" style="max-width: 480px;" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3 class="modal-title" style="color: #991b1b;">Confirmar eliminación de cuenta</h3>
                <button type="button" class="modal-close-btn" @onclick="CancelarEliminar">&times;</button>
            </div>
            <div class="modal-body">
                <p style="color: var(--slate-700);">
                    ¿Estás segura/o de que querés eliminar tu cuenta de academia? Esta acción no se puede deshacer y se borrarán todos los datos de la academia permanentemente.
                </p>
            </div>
            <div class="modal-footer" style="justify-content: flex-end; gap: 0.75rem;">
                <button type="button" class="btn btn-outline" @onclick="CancelarEliminar">Cancelar</button>
                <button type="button" class="btn btn-primary" style="background: #dc2626;" @onclick="EliminarCuenta">
                    Sí, eliminar definitivamente
                </button>
            </div>
        </div>
    </div>
}

@code {
    private AcademiaRespuesta? academia;

    private string nombre = "";
    private string email = "";
    private string telefono = "";
    private string ubicacion = "";
    private string descripcion = "";
    private string codigo = "";
    private bool activa = true;

    private decimal? precioPorHora;
    private decimal? precioPorCurso;

    private bool cargando = true;
    private bool guardando = false;
    private bool guardandoPrecios = false;

    // Vista de demostración para usuarios sin sesión (no redirige al login).
    private bool modoDemo = false;

    private bool mostrarConfirmacionEliminar = false;

    private string mensaje = "";
    private bool guardadoCorrectamente = false;

    private string mensajeFoto = "";
    private string mensajePrecios = "";
    private bool guardadoPreciosCorrecto = false;

    public class AcademiaRespuesta
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Code { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public string? Location { get; set; }
        public string? Phone { get; set; }
        public string? Email { get; set; }
        public int? ResponsableId { get; set; }
        public bool IsActive { get; set; }
        public decimal? PricePerHour { get; set; }
        public decimal? PricePerCourse { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            await CargarAcademia();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error en OnAfterRenderAsync: " + ex.Message);
            CargarDemo();
        }
    }

    private async Task CargarAcademia()
    {
        string? token = null;
        try
        {
            token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                        ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");
        }
        catch
        {
            CargarDemo();
            return;
        }

        // Sin sesión: mostrar la página en modo demostración en vez de redirigir al login.
        if (string.IsNullOrEmpty(token))
        {
            CargarDemo();
            return;
        }

        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get, "api/Academia/mia");
            request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var respuesta = await Http.SendAsync(request);

            if (respuesta.StatusCode == System.Net.HttpStatusCode.Unauthorized ||
                respuesta.StatusCode == System.Net.HttpStatusCode.Forbidden ||
                respuesta.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                CargarDemo();
                return;
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                CargarDemo();
                return;
            }

            academia = await respuesta.Content.ReadFromJsonAsync<AcademiaRespuesta>();

            if (academia != null)
            {
                nombre = academia.Name;
                email = academia.Email ?? "";
                telefono = academia.Phone ?? "";
                ubicacion = academia.Location ?? "";
                descripcion = academia.Description ?? "";
                codigo = academia.Code ?? "";
                activa = academia.IsActive;
                precioPorHora = academia.PricePerHour;
                precioPorCurso = academia.PricePerCourse;
            }
            else
            {
                CargarDemo();
            }
        }
        catch
        {
            CargarDemo();
        }
        finally
        {
            cargando = false;
        }
    }

    // Datos de ejemplo para que un usuario común pueda previsualizar el panel.
    private void CargarDemo()
    {
        modoDemo = true;
        academia = new AcademiaRespuesta
        {
            Id = 0,
            Name = "Academia Aprender",
            Description = "Instituto de apoyo escolar primario con talleres de matemática, lectoescritura e inglés. Contamos con docentes verificados y seguimiento psicopedagógico para acompañar a cada familia.",
            Code = "APRENDER",
            Location = "Nueva Córdoba, Córdoba",
            Phone = "+54 9 351 555-6677",
            Email = "aprender@udx.com",
            IsActive = true,
            PricePerHour = 8000,
            PricePerCourse = 25000
        };

        nombre = academia.Name;
        email = academia.Email ?? "";
        telefono = academia.Phone ?? "";
        ubicacion = academia.Location ?? "";
        descripcion = academia.Description ?? "";
        codigo = academia.Code ?? "";
        activa = academia.IsActive;
        precioPorHora = academia.PricePerHour;
        precioPorCurso = academia.PricePerCourse;

        cargando = false;
    }

    private async Task GuardarCambios()
    {
        mensaje = "";
        guardadoCorrectamente = false;

        if (modoDemo)
        {
            mensaje = "Estás viendo una vista de demostración. Iniciá sesión como academia para editar.";
            guardadoCorrectamente = false;
            return;
        }

        if (academia == null) return;

        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                    ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

        if (string.IsNullOrEmpty(token))
        {
            mensaje = "No hay una sesión iniciada.";
            return;
        }

        guardando = true;

        var datos = new
        {
            Description = descripcion,
            Location = ubicacion,
            Phone = telefono,
            Email = email
        };

        using var request = new HttpRequestMessage(HttpMethod.Put, $"api/Academia/{academia.Id}")
        {
            Content = JsonContent.Create(datos)
        };
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var respuesta = await Http.SendAsync(request);

        if (!respuesta.IsSuccessStatusCode)
        {
            mensaje = "No se pudieron guardar los cambios.";
            guardadoCorrectamente = false;
            guardando = false;
            return;
        }

        mensaje = "Información de la academia actualizada correctamente.";
        guardadoCorrectamente = true;
        guardando = false;
    }

    private async Task GuardarPrecios()
    {
        mensajePrecios = "";
        guardadoPreciosCorrecto = false;

        if (modoDemo)
        {
            mensajePrecios = "Estás viendo una vista de demostración. Iniciá sesión como academia para editar.";
            guardadoPreciosCorrecto = false;
            return;
        }

        if (academia == null) return;

        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                    ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

        if (string.IsNullOrEmpty(token))
        {
            mensajePrecios = "No hay una sesión iniciada.";
            return;
        }

        guardandoPrecios = true;

        var datos = new
        {
            PricePerHour = precioPorHora,
            PricePerCourse = precioPorCurso
        };

        using var request = new HttpRequestMessage(HttpMethod.Put, $"api/Academia/{academia.Id}/precios")
        {
            Content = JsonContent.Create(datos)
        };
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var respuesta = await Http.SendAsync(request);

        if (!respuesta.IsSuccessStatusCode)
        {
            mensajePrecios = "No se pudieron guardar las tarifas.";
            guardadoPreciosCorrecto = false;
            guardandoPrecios = false;
            return;
        }

        mensajePrecios = "Tarifas actualizadas correctamente.";
        guardadoPreciosCorrecto = true;
        guardandoPrecios = false;
    }

    private async Task CerrarSesion()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "token");
            await JS.InvokeVoidAsync("localStorage.removeItem", "role");
            await JS.InvokeVoidAsync("localStorage.removeItem", "name");
            await JS.InvokeVoidAsync("localStorage.removeItem", "udx_token");
            await JS.InvokeVoidAsync("localStorage.removeItem", "udx_name");
            await JS.InvokeVoidAsync("localStorage.removeItem", "udx_role");
            await JS.InvokeVoidAsync("localStorage.removeItem", "udx_email");
            await JS.InvokeVoidAsync("localStorage.removeItem", "udx_fotoPerfil");
            PhotoState.Clear();
        }
        catch
        {
            // Ignorar errores de almacenamiento local al cerrar sesión
        }
        finally
        {
            Navigation.NavigateTo("/", forceLoad: true);
        }
    }

    private void MostrarConfirmacionEliminar() => mostrarConfirmacionEliminar = true;
    private void CancelarEliminar() => mostrarConfirmacionEliminar = false;

    private async Task EliminarCuenta()
    {
        if (academia == null) return;

        var token = await JS.InvokeAsync<string?>("localStorage.getItem", "token")
                    ?? await JS.InvokeAsync<string?>("localStorage.getItem", "udx_token");

        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        using var request = new HttpRequestMessage(HttpMethod.Delete, $"api/Academia/{academia.Id}/cuenta");
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        var respuesta = await Http.SendAsync(request);

        if (!respuesta.IsSuccessStatusCode)
        {
            mensaje = "No se pudo eliminar la cuenta.";
            mostrarConfirmacionEliminar = false;
            return;
        }

        await CerrarSesion();
    }
}