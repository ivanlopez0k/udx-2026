@page "/profesores-demo/juan-perez"

<PageTitle>Perfil de Juan Pérez</PageTitle>

<div class="container mt-4 mb-5">
    <div class="card p-4 shadow-sm">

        <div class="text-center">
            <img src="/IMG/profesor2.jpg"
                 alt="Juan Pérez"
                 class="rounded-circle mb-3"
                 style="width: 150px; height: 150px; object-fit: cover;" />

            <h1>Juan Pérez</h1>

            <span class="badge bg-secondary">Perfil de demostración</span>

            <p class="mt-3">
                <strong>Materia:</strong> Lengua
            </p>

            <p>
                Clases de apoyo para alumnos de primaria.
            </p>

            <p>
                <strong>Calificación:</strong> 4.8 / 5
            </p>

            <p>
                <strong>Modalidad / disponibilidad:</strong>
                Consultar disponibilidad
            </p>
        </div>

        <hr />

        <h3>Materias que enseña</h3>

        <ul>
            <li>Lengua · Nivel primario</li>
        </ul>

        <div class="text-center mt-4">
            <button class="btn btn-secondary"
                    @onclick="Volver">
                Volver
            </button>
        </div>

    </div>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void Volver()
    {
        Navigation.NavigateTo("/");
    }
}
