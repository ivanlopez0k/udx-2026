@page "/profesores/{Id:int}"
@using System.Net.Http.Json
@using UDX.Shared.DTOs
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS


<PageTitle>Perfil del docente</PageTitle>

@if (cargando)
{
    <p class="text-center mt-4">Cargando perfil del docente...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-4">
        @error
    </div>
}
else if (docente != null)
{
    <div class="card p-4 mt-4">

        <div class="text-center">
            @if (!string.IsNullOrWhiteSpace(docente.Foto))
            {
                <img src="@docente.Foto"
                     alt="Foto del docente"
                     class="rounded-circle mb-3"
                     style="width: 150px; height: 150px; object-fit: cover;" />
                
            }

            <h2>@docente.Nombre</h2>

            @if (docente.Verified)
            {
                <span class="badge bg-success">Docente verificado</span>
            }

            <p class="text-muted mt-2">
                @docente.Location
            </p>

            <p>
                <strong>Calificación:</strong>
                @docente.RatingAvg.ToString("N1") / 5
                (@docente.RatingCount opiniones)
            </p>
        </div>

        <hr />

        <h4>Información de contacto</h4>
        <p><strong>Email:</strong> @docente.Email</p>
        <p><strong>Teléfono:</strong> @docente.Phone</p>
        <p><strong>Credenciales:</strong> @docente.Credentials</p>

        <h4>Disponibilidad</h4>
        <p>@docente.Availability</p>

        

        <h4>Materias que enseña</h4>

        @if (docente.Materias.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Materia</th>
                            <th>Nivel</th>
                            <th>Precio por hora</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var materia in docente.Materias)
                        {
                            <tr>
                                <td>@materia.Name</td>
                                <td>@materia.Level</td>
                                <td>$@materia.HourlyRate.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p>No tiene materias registradas.</p>
        }

        <div class="text-center mt-4">
            <button class="btn btn-primary"
                    @onclick="ContratarClase">
                Contratar clase
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger mt-3">
                @error
            </div>
        }
    </div>
}
@if (mostrarFormulario)
{
    <hr />

    <div class="card p-4 mt-3">
        <h3>Solicitar una clase</h3>

        <p class="text-muted">
            Completá los datos para enviar una solicitud al docente.
        </p>

       

        <div class="mb-3">
            <label class="form-label">Materia y nivel</label>

            <select class="form-select"
                    value="@ofertaSeleccionada"
                    @onchange="CambiarOferta">

                <option value="">Seleccioná una materia</option>

                @foreach (var materia in docente!.Materias)
                {
                    <option value="@(materia.Id + "|" + materia.Level)">
                        @materia.Name - @materia.Level
                    </option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Fecha y hora de la clase</label>
            <input type="datetime-local"
                   class="form-control"
                   @bind="fechaClase" />
        </div>

        <div class="mb-3">
            <label class="form-label">Duración</label>

            <select class="form-select" @bind="duracion">
                <option value="1">1 hora</option>
                <option value="2">2 horas</option>
                <option value="3">3 horas</option>
                <option value="4">4 horas</option>
            </select>
        </div>

        <div class="alert alert-info">
            <strong>Precio estimado:</strong>
            $@PrecioEstimado.ToString("N2")
        </div>

        <div class="mb-3">
            <label class="form-label">Modalidad</label>

            <select class="form-select" @bind="modalidad">
                <option value="ONLINE">Online</option>
                <option value="PRESENCIAL">Presencial</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Mensaje para el docente</label>

            <textarea class="form-control"
                      @bind="mensajeSolicitud"
                      rows="3"
                      placeholder="Contale al docente qué necesitás aprender..."></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label">Notas adicionales (opcional)</label>

            <textarea class="form-control"
                      @bind="notas"
                      rows="2"
                      placeholder="Información adicional..."></textarea>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary"
                    @onclick="EnviarSolicitud"
                    disabled="@enviandoSolicitud">

                @if (enviandoSolicitud)
                {
                    <span>Enviando...</span>
                }
                else
                {
                    <span>Enviar solicitud</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensajeFormulario))
        {
            <div class="alert @(solicitudExitosa ? "alert-success" : "alert-danger") mt-3">
                @mensajeFormulario
            </div>
        }
    </div>
}

@code {
    private int parentId;
    
    private int materiaId;

    private string nivel = "";
    private string modalidad = "ONLINE";
    private string mensajeSolicitud = "";
    private string notas = "";
    private string ofertaSeleccionada = "";

    private DateTime fechaClase = DateTime.Now.AddDays(1);

    private int duracion = 1;

    private bool mostrarFormulario = false;
    private bool enviandoSolicitud = false;
    private bool solicitudExitosa = false;

    private string mensajeFormulario = "";

    [Parameter]
    public int Id { get; set; }

    private DocenteDetalleDTO? docente;
    private bool cargando = true;
    private string error = "";

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        error = "";
        docente = null;

        try
        {
            using var respuesta = await Http.GetAsync($"api/Docente/{Id}");

            if (respuesta.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                error = "No se encontró el docente.";
                return;
            }

            respuesta.EnsureSuccessStatusCode();

            docente = await respuesta.Content
                .ReadFromJsonAsync<DocenteDetalleDTO>();

            if (docente == null)
            {
                error = "No se encontró el docente.";
            }
        }
        catch (HttpRequestException)
        {
            error = "No se pudo consultar el docente.";
        }
        catch (System.Text.Json.JsonException)
        {
            error = "La respuesta del servidor no tiene el formato esperado.";
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task ContratarClase()
    {
        error = "Verificando sesión...";

        try
        {
            var token = await JS.InvokeAsync<string>(
                "localStorage.getItem",
                "token");

            if (string.IsNullOrWhiteSpace(token))
            {
                error = "No se encontró el token. Debés iniciar sesión.";
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new System.Net.Http.Headers.AuthenticationHeaderValue(
                    "Bearer",
                    token);

            error = "Consultando perfil de padre...";

            var respuesta = await Http.GetAsync("api/Padre/perfil");

            if (respuesta.StatusCode == System.Net.HttpStatusCode.Unauthorized ||
                respuesta.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                error = "La sesión no corresponde a una cuenta de padre.";
                return;
            }

            if (!respuesta.IsSuccessStatusCode)
            {
                error = $"Error al consultar el perfil. Código: {(int)respuesta.StatusCode}";
                return;
            }

            var perfil = await respuesta.Content
                .ReadFromJsonAsync<PerfilPadreDTO>();

            if (perfil == null)
            {
                error = "No se encontraron los datos del padre.";
                return;
            }

            parentId = perfil.Id;
            error = "";
            mostrarFormulario = true;
        }
        catch (Exception ex)
        {
            error = $"Error al verificar la cuenta: {ex.Message}";
        }
    }

    private void SeleccionarOferta(string valor)
    {
        ofertaSeleccionada = valor;

        var partes = valor.Split('|');

        if (partes.Length == 2 &&
            int.TryParse(partes[0], out var id))
        {
            materiaId = id;
            nivel = partes[1];
        }
        else
        {
            materiaId = 0;
            nivel = "";
        }
    }

    private void CambiarOferta(ChangeEventArgs e)
    {
        SeleccionarOferta(e.Value?.ToString() ?? "");
    }

    private decimal PrecioEstimado
    {
        get
        {
            var materia = docente?.Materias.FirstOrDefault(m =>
                m.Id == materiaId && m.Level == nivel);

            return materia == null
                ? 0
                : materia.HourlyRate * duracion;
        }
    }

    private async Task EnviarSolicitud()
    {
        mensajeFormulario = "";
        solicitudExitosa = false;

       

        if (materiaId <= 0 || string.IsNullOrWhiteSpace(nivel))
        {
            mensajeFormulario = "Seleccioná una materia y un nivel.";
            return;
        }

        if (fechaClase <= DateTime.Now)
        {
            mensajeFormulario = "La fecha de la clase debe ser futura.";
            return;
        }

        if (duracion < 1 || duracion > 4)
        {
            mensajeFormulario = "La duración debe ser de entre 1 y 4 horas.";
            return;
        }

        if (string.IsNullOrWhiteSpace(mensajeSolicitud))
        {
            mensajeFormulario = "Escribí un mensaje para el docente.";
            return;
        }

        if (string.IsNullOrWhiteSpace(modalidad))
        {
            mensajeFormulario = "Seleccioná una modalidad.";
            return;
        }

        enviandoSolicitud = true;

        try
        {
            var dto = new CrearSolicitudDTO
            {
                ParentId = parentId,
                DocenteId = Id,
                MateriaId = materiaId,
                Level = nivel,

                Schedule = new DateTimeOffset(
        DateTime.SpecifyKind(fechaClase, DateTimeKind.Local)),

                Duration = duracion,
                Notes = notas,
                Message = mensajeSolicitud.Trim(),
                Modalidad = modalidad
            };

            var respuesta = await Http.PostAsJsonAsync(
                "api/SolicitudClase",
                dto);

            if (respuesta.IsSuccessStatusCode)
            {
                solicitudExitosa = true;
                mensajeFormulario = "¡Solicitud enviada correctamente!";
            }
            else
            {
                var detalle = await respuesta.Content.ReadAsStringAsync();

                mensajeFormulario = string.IsNullOrWhiteSpace(detalle)
                    ? "No se pudo enviar la solicitud."
                    : detalle;
            }
        }
        catch (Exception)
        {
            mensajeFormulario = "Ocurrió un error al enviar la solicitud.";
        }
        finally
        {
            enviandoSolicitud = false;
        }
    }
}
